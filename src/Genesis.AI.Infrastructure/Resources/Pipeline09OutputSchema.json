{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/schemas/v2_output_schemas.json",
  "title": "V2 Output Schemas (per-file collection)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checks.json": {
      "type": "object",
      "required": ["requirement_id", "checks"],
      "properties": {
        "requirement_id": {"type": "string"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check_id", "title"],
            "properties": {
              "check_id": {"type": "string"},
              "title": {"type": "string"},
              "guardrail_id": {"type": ["string", "null"]},
              "hazard_id": {"type": ["string", "null"]},
              "trigger": {"type": ["string", "null"]},
              "test_scenarios": {"type": "array", "items": {"type": "object"}},
              "pass_criteria": {"type": ["string", "null"]},
              "phase_origin": {"type": ["string", "null"]},
              "v3_guardrails": {"type": "array", "items": {"type": "string"}},
              "target_components": {"type": "array", "items": {"type": "string"}},
              "type": {"type": "string"},
              "entity_state_before": {"type": ["string", "null"]},
              "entity_state_after": {"type": ["string", "null"]},
              "user_action": {"type": ["string", "null"]},
              "expected_component": {"type": ["string", "null"]},
              "notes": {"type": ["string", "null"]}
            },
            "additionalProperties": true,
            "if": {
              "properties": {"type": {"const": "state_transition"}},
              "required": ["type"]
            },
            "then": {
              "required": ["entity_state_before", "entity_state_after", "user_action", "expected_component"],
              "properties": {
                "entity_state_before": {"type": "string"},
                "entity_state_after": {"type": "string"},
                "user_action": {"type": "string"},
                "expected_component": {"type": "string"}
              }
            }
          }
        },
        "observable_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["span_name", "type", "category"],
            "properties": {
              "span_name": {"type": "string"},
              "type": {"enum": ["span", "event"]},
              "category": {"type": "string"},
              "description": {"type": ["string", "null"]},
              "attributes": {"type": "array", "items": {"type": "string"}},
              "clin009_compliant": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    ,
    "examples": [
      {
        "requirement_id": "AUROFORGE_REQ042",
        "checks": [
          {
            "check_id": "CHECK-42",
            "type": "state_transition",
            "title": "State Transition: Consultation: Draft → Consultation: Published",
            "guardrail_id": null,
            "hazard_id": null,
            "phase_origin": "V1d PxD",
            "target_components": ["ConsultationView"],
            "trigger": "Clinician clicks \"Publish\"",
            "entity_state_before": "Consultation: Draft",
            "entity_state_after": "Consultation: Published",
            "expected_component": "ConsultationView (status=\"published\", showBanner=true)",
            "notes": "Should notify patient via subscription",
            "test_scenarios": [
              {
                "name": "State transition: Consultation Draft + Publish",
                "setup": "System is in state: Consultation: Draft",
                "action": "Clinician clicks \"Publish\"",
                "assertion": "Component ConsultationView is rendered with status=\"published\" and showBanner=true. Entity state is Consultation: Published.",
                "forbidden": null
              }
            ],
            "pass_criteria": "ConsultationView renders correctly with published state and patient notification occurs"
          }
        ]
      }
    ],
    "additionalProperties": true
    },

    "hazards.json": {
      "type": "object",
      "required": ["requirement_id", "hazards"],
      "properties": {
        "requirement_id": {"type": "string"},
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hazard_id"],
            "properties": {
              "hazard_id": {"type": "string"},
              "title": {"type": ["string", "null"]},
              "severity": {"type": ["string", "null"]},
              "likelihood": {"type": ["string", "null"]},
              "initial_risk": {"type": ["string", "null"]},
              "controls": {"type": "array", "items": {"type": "string"}},
              "verification": {
                "type": "object",
                "properties": {
                  "check_ids": {"type": "array", "items": {"type": "string"}},
                  "evidence": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": true
              },
              "residual_risk": {"type": ["object", "null"]}
            },
            "additionalProperties": true
          }
        },
        "cso_approval": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },

    "api_contracts.json": {
      "type": "object",
      "required": ["requirement_id", "endpoints"],
      "properties": {
        "requirement_id": {"type": "string"},
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "path"],
            "properties": {
              "method": {"type": "string"},
              "path": {"type": "string"},
              "handler": {"type": ["string", "null"]},
              "scope": {"type": ["string", "null"]},
              "summary": {"type": ["string", "null"]},
              "parameters": {"type": "array", "items": {"type": "object"}},
              "request_body": {"type": ["object", "null"]},
              "responses": {"type": "object"},
              "guardrail_ids": {"type": "array", "items": {"type": "string"}},
              "checks": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "schema.json": {
      "type": "object",
      "required": ["requirement_id", "tables"],
      "properties": {
        "requirement_id": {"type": "string"},
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["table_name"],
            "properties": {
              "table_name": {"type": "string"},
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {"type": "string"},
                    "type": {"type": "string"},
                    "nullable": {"type": "boolean"},
                    "primary_key": {"type": "boolean"},
                    "default": {},
                    "constraints": {"type": "array", "items": {"type": "string"}}
                  },
                  "additionalProperties": true
                }
              },
              "indexes": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "interfaces.json": {
      "type": "object",
      "required": ["requirement_id", "interfaces"],
      "properties": {
        "requirement_id": {"type": "string"},
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["interface_name"],
            "properties": {
              "interface_name": {"type": "string"},
              "namespace": {"type": ["string", "null"]},
              "methods": {
                "type": "array",
                "items": {"type": "object"}
              },
              "guardrail_ids": {"type": "array", "items": {"type": "string"}},
              "checks": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "components.json": {
      "type": "object",
      "required": ["requirement_id", "components"],
      "properties": {
        "requirement_id": {"type": "string"},
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component_name"],
            "properties": {
              "component_name": {"type": "string"},
              "description": {"type": ["string", "null"]},
              "props": {"type": "array", "items": {"type": "object"}},
              "state": {"type": "array", "items": {"type": "object"}},
              "sub_components": {"type": "array", "items": {"type": "string"}},
              "interactions": {"type": "array", "items": {"type": "object"}},
              "accessibility": {"type": "object"},
              "design_tokens": {"type": "object"},
              "i18n_keys": {"type": "array", "items": {"type": "string"}},
              "checks": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "observability.json": {
      "type": "object",
      "required": ["requirement_id"],
      "properties": {
        "requirement_id": {"type": "string"},
        "product_kpis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kpi_id": {"type": "string"},
              "name": {"type": "string"},
              "baseline": {"type": ["string", "null"]},
              "target": {"type": ["string", "null"]},
              "measurement_method": {"type": "string"},
              "source_spans": {"type": "array", "items": {"type": "string"}},
              "source_attribute": {"type": ["string", "null"]},
              "alert_threshold": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "performance_slos": {
          "type": "array",
          "items": {"type": "object"}
        },
        "alerting_conditions": {
          "type": "array",
          "items": {"type": "object"}
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["checks.json", "hazards.json", "api_contracts.json", "schema.json", "interfaces.json", "components.json", "observability.json"]
}
