    var rv = document.getElementById('bulk-code-results-view'); if (rv) rv.style.display = '';
  }

  /* ── REQ-010: Routing rules disclaimer + builder ── */
  function showDisclaimerModal() {
    var cb = document.getElementById('disclaimerCheckbox');
    if (cb) cb.checked = false;
    var btn = document.getElementById('disclaimerSaveBtn');
    if (btn) btn.disabled = true;
    document.getElementById('routingDisclaimerOverlay').classList.add('open');
  }
  function toggleDisclaimerSave() {
    var checked = document.getElementById('disclaimerCheckbox').checked;
    var btn = document.getElementById('disclaimerSaveBtn');
    if (btn) btn.disabled = !checked;
  }
  function saveRoutingRule() {
    closeOverlay('routingDisclaimerOverlay');
    showToast('Rule saved — disclaimer acknowledgement recorded in audit trail (CLIN-002)', 'success');
    showScreen('routing-rules');
  }
  var _condCount = 3;
  function addCond() {
    var list = document.getElementById('cond-list');
    if (!list) return;
    var id = 'cond-' + _condCount++;
    var row = document.createElement('div');
    row.className = 'cond-row'; row.id = id;
    row.innerHTML = '<select style="max-width:150px"><option>Document type</option><option>Urgency</option><option>Source</option><option>Department</option><option>Title contains</option></select><span style="font-size:12px;color:#6b7280;white-space:nowrap">equals</span><input type="text" placeholder="Value" /><button class="remove-cond" onclick="removeCond(\'' + id + '\')">✕</button>';
    list.appendChild(row);
  }
  function removeCond(id) {
    var el = document.getElementById(id);
    if (el) el.remove();
  }
  /* ── REQ-013: Text-selection → Code Picker pre-populate ── */
  function prePopulateCode(el) {
    var text = el ? el.textContent.trim() : '';
    var input = document.getElementById('codeSearch');
    if (input) { input.value = text; input.focus(); }
    showToast('Code Picker pre-populated: “' + text + '” — search to find SNOMED code', 'info');
  }

  function validateAndFileDocument(mode) {
    var keys = mode === 'mail'
      ? ['mail-docType', 'mail-docDate', 'mail-docTitle']
      : ['file-docType', 'file-docDate', 'file-docTitle'];
    var missing = [];
    keys.forEach(function(id) {
      var field = document.getElementById(id);
      var err = document.getElementById(id + '-error');
      var isMissing = !field || !String(field.value || '').trim();
      if (field) field.classList.toggle('field-invalid', isMissing);
      if (err) err.style.display = isMissing ? 'block' : 'none';
      if (isMissing) missing.push(id);
    });
    if (missing.length) {
      showToast('Complete all required filing fields before continuing.', 'warn');
      return;
    }
    showToast('Document filed — moving to Coding queue', 'success');
    showScreen('filing-queue');
    switchTab('coding');
  }

  function runCodingQueueSearch() {
    var input = document.getElementById('codingQueueSearch');
    var q = (input ? input.value : '').trim();
    var results = document.getElementById('codingQueueResults');
    if (!results) return;
    if (!q) {
      results.innerHTML = '<div class="callout callout-warn"><span>⚠️</span><span>Enter a search term to find SNOMED codes.</span></div>';
      return;
    }
    if (q.toLowerCase().indexOf('zzz') !== -1) {
      results.innerHTML = '<div class="callout callout-info"><span>ℹ️</span><span>No codes found for “' + _escHtml(q) + '”.</span></div>';
      return;
    }
    results.innerHTML = [
      '<div style="border:1.5px solid #e0f2fe;border-radius:8px;padding:10px 12px;background:#f0f9ff;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;">',
      '<div><div style="font-size:13px;font-weight:600">Type 2 diabetes mellitus <span style="font-size:11px;color:#0369a1;font-weight:400">📖 Dictionary match · QOF</span></div><div style="font-size:11px;color:#6b7280">SNOMED: 44054006</div></div>',
      '<button class="btn btn-secondary" style="font-size:12px;padding:4px 10px" onclick="addCodingQueueCode(this)">+ Stage</button>',
      '</div>',
      '<div style="border:1.5px solid #e5e7eb;border-radius:8px;padding:10px 12px;background:#fff;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;">',
      '<div><div style="font-size:13px;font-weight:600">Diabetes mellitus type 2 monitoring</div><div style="font-size:11px;color:#6b7280">SNOMED: 395204000</div></div>',
      '<button class="btn btn-secondary" style="font-size:12px;padding:4px 10px" onclick="addCodingQueueCode(this)">+ Stage</button>',
      '</div>',
      '<div style="font-size:11px;color:#6b7280">Showing 2 of 10 results · Prototype paging placeholder</div>'
    ].join('');
  }

  function addCodingQueueCode(btn) {
    btn.textContent = 'Added ✓';
    btn.disabled = true;
    showToast('Code staged for commit', 'success');
  }

  function resetViewerState() {
    showToast('Viewer reset to default zoom and page.', 'info');
  }

  /* ── REQ-007: Add 🏷 Tag button to all Filing tab rows at startup ── */
  document.querySelectorAll('#tab-filing .row-actions').forEach(function(cell) {
    var btn = document.createElement('button');
    btn.innerHTML = '🏷'; btn.title = 'Apply tag';
    btn.onclick = function(e) { e.stopPropagation(); openTagPicker(btn); };
    cell.insertBefore(btn, cell.firstChild);
  });

  /* ── REQ-007 Part 2: Wire checkboxes + drag to filing/coding rows at startup ── */
  _initTabTotals();
  switchTab('filing');
  runCodingQueueSearch();

  document.querySelectorAll('.viewer-toolbar').forEach(function(toolbar) {
    var resetBtn = document.createElement('button');
    resetBtn.textContent = 'Reset view';
    resetBtn.onclick = function() { resetViewerState(); };
    toolbar.appendChild(resetBtn);
  });
  // Filing tab select-all
  (function() {
    var fh = document.querySelector('#tab-filing table thead tr th:first-child');
    if (fh) { var fcb = document.createElement('input'); fcb.type='checkbox'; fcb.id='filing-select-all'; fcb.title='Select all'; fcb.style.marginRight='4px'; fcb.onchange=function(){toggleSelectAll('filing');}; fh.insertBefore(fcb,fh.firstChild); }
    // Filing tab row checkboxes + drag
    document.querySelectorAll('#tab-filing tbody tr').forEach(function(row) {
      var fc = row.cells[0];
      if (fc) { var cb=document.createElement('input'); cb.type='checkbox'; cb.className='row-checkbox'; cb.onclick=function(e){e.stopPropagation();}; cb.onchange=function(e){e.stopPropagation();updateBulkBar();}; fc.insertBefore(cb,fc.firstChild); }
      row.setAttribute('draggable','true');
      row.ondragstart = function(e) {
        var tc = row.querySelector('.title-cell');
        var title = tc ? (tc.firstChild && tc.firstChild.nodeType===3 ? tc.firstChild.textContent.trim() : tc.textContent.trim().split('\n')[0]) : 'Document';
        e.dataTransfer.setData('text/plain', title); e.dataTransfer.effectAllowed='copy'; _dragSourceRow=row;
      };
    });
    // Coding tab select-all
    var ch = document.querySelector('#tab-coding table thead tr th:first-child');
    if (ch) { var ccb=document.createElement('input'); ccb.type='checkbox'; ccb.id='coding-select-all'; ccb.title='Select all'; ccb.style.marginRight='4px'; ccb.onchange=function(){toggleSelectAll('coding');}; ch.insertBefore(ccb,ch.firstChild); }
    // Coding tab row checkboxes
    document.querySelectorAll('#tab-coding tbody tr').forEach(function(row) {
      var fc = row.cells[0];
      if (fc) { var cb=document.createElement('input'); cb.type='checkbox'; cb.className='row-checkbox'; cb.onclick=function(e){e.stopPropagation();}; cb.onchange=function(e){e.stopPropagation();updateBulkBar();}; fc.insertBefore(cb,fc.firstChild); }
    });
  })();

  /* ── Wire all ✏️ Annotate toolbar buttons to annotation panel ── */
  document.querySelectorAll('.viewer-toolbar button').forEach(function(b) {
    if (b.textContent.trim() === '✏️ Annotate') { b.onclick = function() { openAnnotatePanel(); }; }
  });
</script>
</body>
</html>
