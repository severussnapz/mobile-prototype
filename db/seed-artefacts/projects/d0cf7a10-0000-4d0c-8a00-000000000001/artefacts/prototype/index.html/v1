  /* ── REQ-007: Sort ── */
  var _sortIdx = 0;
  var _SORT_LABELS = ['Sort: Newest ▾', 'Sort: Oldest ▴', 'Sort: A–Z'];
  var _ALL_TABS = ['tab-unmatched', 'tab-filing', 'tab-coding', 'tab-tasks'];
  var _MON = { jan:0, feb:1, mar:2, apr:3, may:4, jun:5, jul:6, aug:7, sep:8, oct:9, nov:10, dec:11 };
  function _parseRowDate(text) {
    var p = text.trim().split(' ');
    if (p.length < 3) return new Date(0);
    var mon = _MON[p[1].toLowerCase().substring(0, 3)];
    return new Date(parseInt(p[2]), mon === undefined ? 0 : mon, parseInt(p[0]));
  }
  function cycleSort() {
    _sortIdx = (_sortIdx + 1) % 3;
    var btn = document.getElementById('sort-btn');
    if (btn) btn.textContent = _SORT_LABELS[_sortIdx];
    _ALL_TABS.forEach(function(tabId) {
      var tabEl = document.getElementById(tabId);
      if (!tabEl || tabEl.style.display === 'none') return;
      var tbody = tabEl.querySelector('tbody');
      if (!tbody) return;
      var rows = Array.from(tbody.querySelectorAll('tr'));
      rows.sort(function(a, b) {
        if (_sortIdx === 2) { // A–Z by title
          var ta = a.querySelector('.title-cell') ? a.querySelector('.title-cell').textContent.trim() : '';
          var tb = b.querySelector('.title-cell') ? b.querySelector('.title-cell').textContent.trim() : '';
          return ta.localeCompare(tb);
        }
        var da = a.cells[2] ? _parseRowDate(a.cells[2].textContent) : new Date(0);
        var db = b.cells[2] ? _parseRowDate(b.cells[2].textContent) : new Date(0);
        return _sortIdx === 0 ? db - da : da - db; // 0=newest, 1=oldest
      });
      rows.forEach(function(r) { tbody.appendChild(r); });
    });
    showToast(_SORT_LABELS[_sortIdx] + ' applied', 'info');
  }
  /* ── REQ-007: Filter (row-level) ── */
  function _filterRows(fType, fUrgency, fSrc, fDept, fFrom, fTo) {
    _ALL_TABS.forEach(function(tabId) {
      var tabEl = document.getElementById(tabId);
      if (!tabEl) return;
      tabEl.querySelectorAll('tbody tr').forEach(function(row) {
        var ok = true;
        if (fType) {
          var chip = row.querySelector('.chip-type');
          if (!chip || chip.textContent.trim().toLowerCase() !== fType.toLowerCase()) ok = false;
        }
        if (ok && fSrc) {
          var chip = row.querySelector('.chip-src');
          if (!chip || chip.textContent.toLowerCase().indexOf(fSrc.toLowerCase()) === -1) ok = false;
        }
        if (ok && fUrgency) {
          var u = fUrgency.toLowerCase();
          if (u === 'urgent' && !row.querySelector('.badge-urgent') && !row.querySelector('.urgency-arrow')) ok = false;
          if (u === 'routine' && !row.querySelector('.badge-routine')) ok = false;
          if (u === 'administrative' && !row.querySelector('.badge-admin')) ok = false;
        }
        if (ok && fDept) {
          if (row.textContent.toLowerCase().indexOf(fDept.toLowerCase()) === -1) ok = false;
        }
        if (ok && fFrom && row.cells[2]) {
          if (_parseRowDate(row.cells[2].textContent) < new Date(fFrom)) ok = false;
        }
        if (ok && fTo && row.cells[2]) {
          if (_parseRowDate(row.cells[2].textContent) > new Date(fTo)) ok = false;
        }
        row.dataset.filterMatch = ok ? '1' : '0';
        var searchMatch = row.dataset.searchMatch !== '0';
        row.style.display = (ok && searchMatch) ? '' : 'none';
      });
    });
  }
