<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document Manager Prototype (Approach B)</title>
  <style>
    /* ── Reset & base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #f0f4f8; color: #1a1a2e; font-size: 14px; }

    /* ── Prototype banner ── */
    .proto-banner {
      background: #f59e0b; color: #1a1a2e; padding: 8px 20px;
      font-weight: 700; font-size: 13px; text-align: center; letter-spacing: .3px;
      position: sticky; top: 0; z-index: 999;
    }

    /* ── Shell nav ── */
    .shell-nav {
      background: #005eb8; color: #fff; display: flex; align-items: center;
      padding: 0 20px; height: 52px; gap: 32px;
    }
    .shell-nav .logo { font-weight: 800; font-size: 16px; letter-spacing: -.5px; }
    .shell-nav .logo span { color: #80c8ff; }
    .shell-nav nav { display: flex; gap: 4px; flex: 1; }
    .shell-nav nav a {
      color: rgba(255,255,255,.75); text-decoration: none; padding: 6px 12px;
      border-radius: 6px; font-size: 13px; font-weight: 500;
    }
    .shell-nav nav a.active { background: rgba(255,255,255,.15); color: #fff; }
    .shell-nav nav a:hover { background: rgba(255,255,255,.1); color: #fff; }
    .shell-nav .user { margin-left: auto; font-size: 13px; color: rgba(255,255,255,.8); }

    /* ── Page wrapper ── */
    .page { max-width: 1280px; margin: 0 auto; padding: 24px 20px; }
    .page-header { margin-bottom: 20px; }
    .page-header h1 { font-size: 22px; font-weight: 700; color: #1a1a2e; }
    .page-header p { font-size: 13px; color: #6b7280; margin-top: 4px; }

    /* ── Screen visibility ── */
    .screen { display: none; }
    .screen.active { display: block; }

    /* ── Tab strip ── */
    .tab-strip {
      display: flex; gap: 0; border-bottom: 2px solid #e5e7eb;
      margin-bottom: 20px; overflow-x: auto;
    }
    .tab-strip button {
      background: none; border: none; cursor: pointer;
      padding: 10px 18px; font-size: 13px; font-weight: 600; color: #6b7280;
      border-bottom: 3px solid transparent; margin-bottom: -2px;
      display: flex; align-items: center; gap: 8px; white-space: nowrap;
    }
    .tab-strip button:hover { color: #005eb8; }
    .tab-strip button.active { color: #005eb8; border-bottom-color: #005eb8; }
    .tab-badge {
      background: #e5e7eb; color: #374151; border-radius: 20px;
      padding: 1px 8px; font-size: 11px; font-weight: 700;
    }
    .tab-badge.urgent { background: #fee2e2; color: #b91c1c; }
    .tab-strip button.active .tab-badge { background: #dbeafe; color: #1d4ed8; }

    /* ── Toolbar ── */
    .toolbar {
      display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
    }
    .search-box {
      flex: 1; max-width: 360px; display: flex; align-items: center;
      border: 1.5px solid #d1d5db; border-radius: 8px; padding: 7px 12px;
      background: #fff; gap: 8px;
    }
    .search-box input {
      border: none; outline: none; width: 100%; font-size: 13px; color: #374151;
    }
    .search-icon { color: #9ca3af; font-size: 16px; }
    .btn {
      padding: 7px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
      border: none; cursor: pointer; text-decoration: none; display: inline-flex;
      align-items: center; gap: 6px;
    }
    .btn-primary { background: #005eb8; color: #fff; }
    .btn-primary:hover { background: #004a94; }
    .btn-secondary { background: #fff; color: #374151; border: 1.5px solid #d1d5db; }
    .btn-secondary:hover { background: #f9fafb; }
    .btn-danger { background: #dc2626; color: #fff; }
    .btn-danger:hover { background: #b91c1c; }
    .btn-success { background: #16a34a; color: #fff; }
    .btn-success:hover { background: #15803d; }
    .btn:disabled { opacity: .45; cursor: not-allowed; }

    /* ── Source unavailable banner ── */
    .source-warning {
      background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 8px;
      padding: 10px 14px; margin-bottom: 16px; display: flex; align-items: flex-start;
      gap: 10px; font-size: 13px; color: #92400e;
    }
    .source-warning strong { color: #78350f; }

    /* ── Document table ── */
    .doc-table { width: 100%; border-collapse: collapse; background: #fff;
      border-radius: 10px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
    .doc-table thead th {
      background: #f9fafb; padding: 10px 12px; text-align: left;
      font-size: 11px; font-weight: 700; color: #6b7280; text-transform: uppercase;
      letter-spacing: .6px; border-bottom: 1.5px solid #e5e7eb;
    }
    .doc-table thead th:first-child { width: 32px; }
    .doc-table tbody tr {
      border-bottom: 1px solid #f3f4f6; cursor: pointer; position: relative;
    }
    .doc-table tbody tr:last-child { border-bottom: none; }
    .doc-table tbody tr:hover { background: #f0f7ff; }
    .doc-table tbody tr:hover .row-actions { opacity: 1; }
    .doc-table tbody td { padding: 12px 12px; font-size: 13px; color: #374151; vertical-align: middle; }
    .doc-table tbody td.urgency-cell { width: 32px; padding-right: 4px; text-align: center; }
    .doc-table tbody td.title-cell { font-weight: 600; color: #1a1a2e; max-width: 220px; }
    .doc-table tbody td.patient-cell { color: #1d4ed8; font-weight: 500; }
    .doc-table tbody td.unmatched-cell { color: #9ca3af; font-style: italic; }
    .urgency-arrow { color: #dc2626; font-size: 18px; line-height: 1; }
    .in-progress-badge {
      display: inline-block; background: #dbeafe; color: #1d4ed8;
      border-radius: 20px; padding: 1px 8px; font-size: 11px; font-weight: 700; margin-left: 6px;
    }
    .row-actions { opacity: 0; transition: opacity .15s; }
    .row-actions button {
      background: none; border: 1.5px solid #d1d5db; border-radius: 6px;
      padding: 3px 8px; cursor: pointer; font-size: 16px; color: #6b7280;
    }
    .row-actions button:hover { background: #f3f4f6; }

    /* ── Type / source chips ── */
    .chip {
      display: inline-block; border-radius: 20px; padding: 2px 10px;
      font-size: 11px; font-weight: 600;
    }
    .chip-type { background: #f3e8ff; color: #7c3aed; }
    .chip-src { background: #ecfdf5; color: #065f46; }
    .chip-src-mail { background: #eff6ff; color: #1d4ed8; }

    /* ── Empty state ── */
    .empty-state {
      text-align: center; padding: 60px 20px; color: #9ca3af;
    }
    .empty-state .empty-icon { font-size: 48px; margin-bottom: 12px; }
    .empty-state p { font-size: 14px; margin-bottom: 16px; }

    /* ── ===== GALLERY VIEW ===== ── */
    .gallery-bar {
      display: flex; align-items: center; gap: 12px; padding: 12px 20px;
      background: #fff; border-bottom: 1.5px solid #e5e7eb;
      position: sticky; top: 52px; z-index: 10;
    }
    .gallery-bar .back-link {
      color: #005eb8; text-decoration: none; font-size: 13px; font-weight: 600;
      display: flex; align-items: center; gap: 4px;
    }
    .gallery-bar .back-link:hover { text-decoration: underline; }
    .gallery-bar .doc-title-bar {
      font-size: 14px; font-weight: 700; color: #1a1a2e;
    }
    .gallery-bar .doc-meta-bar { font-size: 12px; color: #6b7280; margin-left: 8px; }
    .gallery-bar .actions-right { margin-left: auto; display: flex; gap: 8px; }

    .gallery-layout {
      display: flex; gap: 0; min-height: calc(100vh - 130px);
    }
    .gallery-layout.with-queue-peek .gallery-viewer {
      flex: 1 1 auto;
      min-width: 0;
    }
    .gallery-layout.with-queue-peek .gallery-panel {
      flex: 0 0 36%;
      min-width: 340px;
    }
    .queue-peek {
      width: 250px;
      flex-shrink: 0;
      background: #fff;
      border-right: 1.5px solid #e5e7eb;
      display: flex;
      flex-direction: column;
    }
    .gallery-layout.peek-collapsed .queue-peek {
      display: none;
    }
    .queue-peek-head {
      padding: 12px 14px;
      border-bottom: 1px solid #e5e7eb;
      background: #f9fafb;
    }
    .queue-peek-title {
      font-size: 12px;
      font-weight: 700;
      color: #374151;
      text-transform: uppercase;
      letter-spacing: .4px;
      margin-bottom: 4px;
    }
    .queue-peek-sub {
      font-size: 11px;
      color: #6b7280;
    }
    .queue-peek-list {
      overflow-y: auto;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .peek-item {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
      line-height: 1.35;
      color: #374151;
      background: #fff;
    }
    .peek-item.active {
      border-color: #93c5fd;
      background: #eff6ff;
    }
    .peek-item-title {
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 2px;
    }
    .peek-item-meta {
      font-size: 11px;
      color: #6b7280;
    }
    .queue-peek-toggle {
      font-size: 12px;
    }
    .gallery-viewer {
      flex: 0 0 62%; background: #374151; display: flex; flex-direction: column;
      align-items: center; justify-content: flex-start; padding: 20px;
      gap: 12px;
    }
    .viewer-toolbar {
      display: flex; align-items: center; gap: 8px; width: 100%;
      background: rgba(255,255,255,.08); border-radius: 8px; padding: 8px 12px;
      position: sticky; top: 0; z-index: 5;
    }
    .viewer-toolbar button {
      background: rgba(255,255,255,.12); border: none; color: #e5e7eb;
      border-radius: 6px; padding: 5px 10px; font-size: 12px; cursor: pointer;
    }
    .viewer-toolbar button:hover { background: rgba(255,255,255,.2); }
    .viewer-toolbar .page-info { color: #9ca3af; font-size: 12px; margin: 0 8px; }
    .doc-preview {
      background: #fff; width: 100%; max-width: 580px; min-height: 700px;
      border-radius: 4px; padding: 40px 48px; box-shadow: 0 4px 24px rgba(0,0,0,.3);
      font-size: 13px; line-height: 1.7; color: #1a1a2e;
    }
    .doc-preview h2 { font-size: 16px; font-weight: 700; margin-bottom: 16px; border-bottom: 1.5px solid #e5e7eb; padding-bottom: 10px; }
    .doc-preview .letterhead { color: #005eb8; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; margin-bottom: 16px; }
    .doc-preview p { margin-bottom: 10px; }
    .doc-preview .highlight { background: #fef08a; padding: 1px 3px; border-radius: 2px; }

    .gallery-panel {
      flex: 0 0 38%; background: #fff; display: flex; flex-direction: column;
      border-left: 1.5px solid #e5e7eb;
    }
    .panel-tabs {
      display: flex; border-bottom: 1.5px solid #e5e7eb; background: #f9fafb;
    }
    .panel-tabs button {
      flex: 1; padding: 12px 8px; background: none; border: none;
      font-size: 12px; font-weight: 600; color: #6b7280; cursor: pointer;
      border-bottom: 3px solid transparent; margin-bottom: -1px;
      display: flex; align-items: center; justify-content: center; gap: 5px;
    }
    .panel-tabs button:hover { color: #005eb8; }
    .panel-tabs button.active { color: #005eb8; border-bottom-color: #005eb8; background: #fff; }
    .panel-tabs button.done { color: #16a34a; }
    .panel-tabs button.done::after { content: ' ✓'; font-size: 11px; }
    .panel-tabs button.locked { color: #d1d5db; cursor: not-allowed; }
    .panel-content { flex: 1; overflow-y: auto; padding: 20px; }
    .panel-footer {
      padding: 16px 20px; border-top: 1.5px solid #e5e7eb;
      display: flex; gap: 8px; align-items: center;
    }
    .panel-footer .next-btn { flex: 1; }

    /* ── Form elements ── */
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block; font-size: 12px; font-weight: 700; color: #374151;
      margin-bottom: 5px; text-transform: uppercase; letter-spacing: .4px;
    }
    .form-group input, .form-group select {
      width: 100%; padding: 8px 10px; border: 1.5px solid #d1d5db;
      border-radius: 7px; font-size: 13px; color: #1a1a2e; background: #fff;
      outline: none;
    }
    .form-group input:focus, .form-group select:focus { border-color: #005eb8; box-shadow: 0 0 0 3px rgba(0,94,184,.12); }
    .form-group .hint { font-size: 11px; color: #9ca3af; margin-top: 4px; }
    .form-group .required-badge {
      display: inline-block; background: #fee2e2; color: #b91c1c;
      border-radius: 4px; padding: 1px 5px; font-size: 10px; font-weight: 700; margin-left: 6px;
    }
    .field-invalid {
      border-color: #dc2626 !important;
      box-shadow: 0 0 0 2px rgba(220,38,38,.12);
      background: #fff7f7 !important;
    }
    .field-error {
      display: none;
      margin-top: 4px;
      font-size: 11px;
      color: #b91c1c;
      font-weight: 600;
    }

    /* ── Patient match card ── */
    .match-option {
      border: 1.5px solid #e5e7eb; border-radius: 8px; padding: 12px 14px;
      margin-bottom: 10px; cursor: pointer; position: relative;
      display: flex; gap: 10px; align-items: flex-start;
    }
    .match-option:hover { border-color: #93c5fd; background: #f0f7ff; }
    .match-option.selected { border-color: #005eb8; background: #eff6ff; }
    .match-option input[type=radio] { margin-top: 3px; accent-color: #005eb8; }
    .match-option .patient-name { font-weight: 700; font-size: 14px; color: #1a1a2e; }
    .match-option .patient-meta { font-size: 12px; color: #6b7280; margin-top: 2px; }
    .match-option .nhs-num { font-family: monospace; color: #374151; }
    .confidence-badge {
      position: absolute; top: 10px; right: 10px;
      border-radius: 20px; padding: 2px 8px; font-size: 11px; font-weight: 700;
    }
    .conf-high { background: #dcfce7; color: #166534; }
    .conf-low { background: #fef9c3; color: #854d0e; }

    /* ── Patient search ── */
    .patient-search-box {
      display: flex; gap: 8px; margin-bottom: 14px;
    }
    .patient-search-box input {
      flex: 1; padding: 8px 10px; border: 1.5px solid #d1d5db;
      border-radius: 7px; font-size: 13px; outline: none;
    }
    .patient-search-box input:focus { border-color: #005eb8; }
    .emis-web-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;
      border-radius: 6px; padding: 3px 10px; font-size: 11px; font-weight: 700;
      margin-bottom: 10px;
    }

    /* ── Status steps ── */
    .status-steps { display: flex; gap: 0; margin-bottom: 20px; }
    .step {
      flex: 1; text-align: center; font-size: 11px; font-weight: 700;
      padding: 8px 4px; color: #9ca3af; position: relative;
    }
    .step::after {
      content: ''; position: absolute; right: 0; top: 50%;
      transform: translateY(-50%); width: 1px; height: 60%; background: #e5e7eb;
    }
    .step:last-child::after { display: none; }
    .step.done { color: #16a34a; }
    .step.active { color: #005eb8; }
    .step .step-icon { font-size: 16px; display: block; margin-bottom: 3px; }

    /* ── Info callout ── */
    .callout {
      border-radius: 8px; padding: 10px 14px; font-size: 12px;
      margin-bottom: 14px; display: flex; gap: 8px; align-items: flex-start;
    }
    .callout-info { background: #eff6ff; border-left: 4px solid #3b82f6; color: #1e40af; }
    .callout-warn { background: #fffbeb; border-left: 4px solid #f59e0b; color: #92400e; }
    .callout-success { background: #f0fdf4; border-left: 4px solid #22c55e; color: #14532d; }

    /* ── Won't be filed dialogue ── */
    .overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,.45); z-index: 500;
      align-items: center; justify-content: center;
    }
    .overlay.open { display: flex; }
    .dialog {
      background: #fff; border-radius: 12px; width: 100%; max-width: 460px;
      padding: 0; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.25);
    }
    .dialog-header {
      padding: 18px 20px 14px; border-bottom: 1.5px solid #e5e7eb;
    }
    .dialog-header h2 { font-size: 16px; font-weight: 700; }
    .dialog-header p { font-size: 13px; color: #6b7280; margin-top: 4px; }
    .dialog-body { padding: 20px; }
    .dialog-footer {
      padding: 14px 20px; border-top: 1.5px solid #e5e7eb;
      display: flex; gap: 8px; justify-content: flex-end;
    }

    /* ── Toast ── */
    .toast {
      display: none; position: fixed; bottom: 24px; right: 24px;
      background: #1a1a2e; color: #fff; border-radius: 10px;
      padding: 12px 18px; font-size: 13px; font-weight: 500;
      box-shadow: 0 8px 24px rgba(0,0,0,.2); z-index: 600;
      max-width: 340px; display: none; align-items: center; gap: 10px;
    }
    .toast.show { display: flex; }
    .toast.success { background: #15803d; }
    .toast.info { background: #1d4ed8; }
    .toast.warn { background: #b45309; }

    /* ── Task filter bar ── */
    .task-filter-bar {
      display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
      padding: 10px 14px; background: #fff; border: 1.5px solid #e5e7eb;
      border-radius: 8px;
    }
    .task-filter-bar label { font-size: 12px; font-weight: 700; color: #6b7280; white-space: nowrap; }
    .task-filter-bar select {
      padding: 6px 10px; border: 1.5px solid #d1d5db; border-radius: 7px;
      font-size: 13px; color: #374151; background: #fff; outline: none;
    }
    .task-filter-bar select:focus { border-color: #005eb8; }
    .filter-tag {
      display: inline-flex; align-items: center; gap: 5px;
      background: #dbeafe; color: #1d4ed8; border-radius: 20px;
      padding: 3px 10px; font-size: 12px; font-weight: 600;
    }
    .filter-tag button { background: none; border: none; cursor: pointer; color: #1d4ed8; font-size: 13px; line-height: 1; padding: 0; }

    /* ── Task type chip ── */
    .chip-task { background: #fff7ed; color: #c2410c; }

    /* ── Confidentiality / visibility group ── */
    .conf-group {
      border: 1.5px solid #e5e7eb; border-radius: 8px; padding: 12px 14px;
      margin-bottom: 14px; background: #fafafa;
    }
    .conf-group .conf-title {
      font-size: 12px; font-weight: 700; color: #374151;
      text-transform: uppercase; letter-spacing: .4px; margin-bottom: 10px;
    }
    .conf-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .conf-row:last-child { margin-bottom: 0; }
    .conf-row .conf-label { font-size: 13px; color: #374151; font-weight: 500; }
    .conf-row .conf-label small { display: block; font-size: 11px; color: #9ca3af; font-weight: 400; }
    .conf-row select {
      width: 175px; padding: 6px 10px; border: 1.5px solid #d1d5db;
      border-radius: 7px; font-size: 12px; color: #1a1a2e; background: #fff; outline: none;
    }
    .conf-row select:focus { border-color: #005eb8; }
    .conf-row select.restricted { border-color: #f59e0b; background: #fffbeb; color: #92400e; font-weight: 600; }
    .conf-row select.confidential { border-color: #dc2626; background: #fef2f2; color: #b91c1c; font-weight: 600; }

    /* ── Queue toolbar (above tabs) ── */
    .queue-toolbar {
      display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap;
    }
    .queue-toolbar .search-box { flex: 0 1 320px; }
    .toolbar-spacer { flex: 1; }

    /* ── Unmatched queue specific ── */
    .unmatched-reason { font-size: 11px; color: #9ca3af; margin-top: 2px; }

    /* ── NHSmail email viewer ── */
    .email-header-block {
      background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 8px;
      padding: 12px 16px; margin-bottom: 16px; font-size: 12px; color: #1e3a5f;
    }
    .email-header-block .eh-row { display: flex; gap: 8px; margin-bottom: 4px; }
    .email-header-block .eh-row:last-child { margin-bottom: 0; }
    .email-header-block .eh-label { font-weight: 700; min-width: 52px; color: #374151; }
    .email-source-badge {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px;
      background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe;
      border-radius: 6px; font-size: 11px; font-weight: 700; margin-bottom: 14px;
    }
    .email-body-section { margin-bottom: 16px; }
    .email-divider {
      border: none; border-top: 2px dashed #d1d5db; margin: 20px 0;
    }
    .email-attachment-bar {
      display: flex; align-items: center; gap: 10px;
      background: #f0f9ff; border: 1.5px solid #bae6fd; border-radius: 8px;
      padding: 10px 14px; margin-bottom: 16px; font-size: 12px;
    }
    .email-attachment-bar .att-name { font-weight: 600; color: #0369a1; flex: 1; }
    .email-attachment-bar .att-size { color: #6b7280; font-size: 11px; }
    .attached-doc-label {
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
      color: #6b7280; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;
    }
    .attached-doc-label::before, .attached-doc-label::after {
