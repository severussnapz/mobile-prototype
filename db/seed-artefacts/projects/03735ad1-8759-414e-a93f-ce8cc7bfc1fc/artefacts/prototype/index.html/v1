    '<div class="msg-avatar" style="background:var(--sl-accent);color:white;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;flex-shrink:0;">🤖</div>' +
    '<div class="loading-bubble">' +
      '<div class="loading-dots"><div class="loading-dot"></div><div class="loading-dot"></div><div class="loading-dot"></div></div>' +
      '<div class="status-text" id="widget-status-text"><span class="status-spinner"></span> <span id="widget-status-label">Searching documentation…</span></div>' +
    '</div>';
  container.appendChild(widgetLoadingEl);
  scrollWidgetToBottom();
  // Cycle through loading steps
  var step = 0;
  loadingStepInterval = setInterval(function() {
    step = (step + 1) % LOADING_STEPS.length;
    var label = document.getElementById('widget-status-label');
    if (label) label.textContent = LOADING_STEPS[step].text;
  }, 600);
}
function hideWidgetLoading() {
  state.isLoading = false;
  document.getElementById('widget-send-btn').disabled = false;
  if (loadingStepInterval) { clearInterval(loadingStepInterval); loadingStepInterval = null; }
  var el = document.getElementById('widget-loading-el');
  if (el) el.remove();
}
function showFullpageLoading() {
  state.isLoading = true;
  var container = document.getElementById('fullpage-messages');
  fullpageLoadingEl = document.createElement('div');
  fullpageLoadingEl.className = 'fullpage-msg bot';
  fullpageLoadingEl.id = 'fullpage-loading-el';
  fullpageLoadingEl.setAttribute('role', 'status');
  fullpageLoadingEl.setAttribute('aria-live', 'polite');
  fullpageLoadingEl.innerHTML =
    '<div class="fullpage-msg-avatar">🤖</div>' +
    '<div class="fullpage-msg-content">' +
      '<div class="fullpage-msg-label">EMIS Interop Assistant</div>' +
      '<div class="loading-bubble" style="border-radius:12px;border-top-left-radius:2px;">' +
        '<div class="loading-dots"><div class="loading-dot"></div><div class="loading-dot"></div><div class="loading-dot"></div></div>' +
        '<div class="status-text"><span class="status-spinner"></span> <span id="fp-status-label">Searching documentation…</span></div>' +
      '</div>' +
    '</div>';
  container.appendChild(fullpageLoadingEl);
  scrollFullpageToBottom();
  var step = 0;
  loadingStepInterval = setInterval(function() {
    step = (step + 1) % LOADING_STEPS.length;
    var label = document.getElementById('fp-status-label');
    if (label) label.textContent = LOADING_STEPS[step].text;
  }, 600);
}
function hideFullpageLoading() {
  state.isLoading = false;
  if (loadingStepInterval) { clearInterval(loadingStepInterval); loadingStepInterval = null; }
  var el = document.getElementById('fullpage-loading-el');
  if (el) el.remove();
}
/* ============================================================
   SCENARIO LOADER (demo toolbar)
   ============================================================ */
function loadScenario(scenarioKey) {
  if (!state.isAuthenticated) {
    alert('Switch to Authenticated mode first.');
    return;
  }
  // Open widget if not open
  if (!state.widgetOpen && !state.isFullPage) {
    state.widgetOpen = true;
    var panel = document.getElementById('widget-panel');
    panel.classList.remove('hidden');
    document.getElementById('widget-fab').setAttribute('aria-expanded', 'true');
    document.getElementById('widget-fab').innerHTML = '✕';
  }
  var scenario = SCENARIOS[scenarioKey];
  if (!scenario) return;
  // Add user message
  state.messages.push({ type: 'user', text: scenario.userMsg });
  if (scenarioKey === 'loading') {
    // Show loading states for 3 seconds then show answer
    if (state.isFullPage) {
      renderFullpageMessages();
      scrollFullpageToBottom();
      showFullpageLoading();
      setTimeout(function() {
        hideFullpageLoading();
        state.messages.push(scenario.botResponse);
        renderFullpageMessages();
        scrollFullpageToBottom();
      }, 3000);
    } else {
      renderWidgetMessages();
      scrollWidgetToBottom();
      showWidgetLoading();
      setTimeout(function() {
        hideWidgetLoading();
        state.messages.push(scenario.botResponse);
        renderWidgetMessages();
        scrollWidgetToBottom();
      }, 3000);
    }
    return;
  }
  // Add bot response immediately for other scenarios
  state.messages.push(scenario.botResponse);
  if (state.isFullPage) {
    renderFullpageMessages();
    scrollFullpageToBottom();
  } else {
    renderWidgetMessages();
    scrollWidgetToBottom();
  }
}
/* ============================================================
   ESCALATION
   ============================================================ */
function submitEscalation(context) {
  var emailInput = document.getElementById('esc-email-' + context);
  var errorEl = document.getElementById('esc-email-error-' + context);
  var submitBtn = document.getElementById('esc-submit-' + context);
  var email = emailInput ? emailInput.value.trim() : '';
  // Validate email (RFC 5322 simplified)
  var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(email)) {
    emailInput.classList.add('error');
    errorEl.classList.add('visible');
    emailInput.focus();
    return;
  }
  // Clear error
  emailInput.classList.remove('error');
  errorEl.classList.remove('visible');
  // Disable submit (idempotency)
  submitBtn.disabled = true;
  submitBtn.textContent = 'Sending…';
  // Simulate dispatch
  setTimeout(function() {
    // Remove the escalation-prompt message and replace with success
    var idx = state.messages.findLastIndex(function(m) { return m.type === 'escalation-prompt'; });
    if (idx === -1) {
      // Fallback: find last index manually
      for (var i = state.messages.length - 1; i >= 0; i--) {
        if (state.messages[i].type === 'escalation-prompt') { idx = i; break; }
      }
    }
    if (idx !== -1) {
      state.messages[idx] = { type: 'escalation-success', email: email };
    } else {
      state.messages.push({ type: 'escalation-success', email: email });
    }
    if (context === 'fullpage') {
      renderFullpageMessages();
      scrollFullpageToBottom();
    } else {
      renderWidgetMessages();
      scrollWidgetToBottom();
    }
  }, 800);
}
/* ============================================================
   CLEAR CONVERSATION
   ============================================================ */
function openClearDialog(target) {
  state.clearTarget = target;
  document.getElementById('clear-dialog').classList.add('open');
}
function closeClearDialog() {
  document.getElementById('clear-dialog').classList.remove('open');
  state.clearTarget = null;
}
function confirmClear() {
  state.messages = [];
  state.messageCount = 0;
  closeClearDialog();
  if (state.isFullPage) {
    renderFullpageMessages();
  } else {
    renderWidgetMessages();
  }
}
/* ============================================================
   RATE LIMIT
   ============================================================ */
function showRateLimitWarning() {
  var footer = document.getElementById('widget-footer-text');
  if (footer) {
    footer.innerHTML = '<span style="color:var(--sl-warning);">⚠️ You\'ve reached the 50 message limit for this session. Please clear your conversation or return tomorrow.</span>';
  }
}
function updateRateLimitDisplay() {
  var footer = document.getElementById('widget-footer-text');
  if (footer) {
    footer.textContent = state.rateLimit + ' messages remaining this session';
    if (state.rateLimit <= 10) {
      footer.style.color = 'var(--sl-warning)';
    }
  }
}
/* ============================================================
   RETRY
   ============================================================ */
function retryLastMessage() {
  // Remove error message and last user message, re-send
  if (state.messages.length >= 2) {
    var last = state.messages[state.messages.length - 1];
    if (last.type === 'error') {
      state.messages.pop(); // remove error
      var userMsg = state.messages[state.messages.length - 1];
      if (userMsg && userMsg.type === 'user') {
        state.messages.pop(); // remove user msg
        var text = userMsg.text;
        // Re-inject
        state.messages.push({ type: 'user', text: text });
        renderWidgetMessages();
        showWidgetLoading();
        setTimeout(function() {
          hideWidgetLoading();
          state.messages.push(SCENARIOS['in-scope'].botResponse);
          renderWidgetMessages();
          scrollWidgetToBottom();
        }, 2000);
      }
    }
  }
}
/* ============================================================
   RESET
   ============================================================ */
function resetAll() {
  state.messages = [];
  state.messageCount = 0;
  state.rateLimit = 50;
  state.isLoading = false;
  if (loadingStepInterval) { clearInterval(loadingStepInterval); loadingStepInterval = null; }
  closeClearDialog();
  if (state.isFullPage) {
    minimiseToWidget();
  }
  if (state.widgetOpen) {
    toggleWidget();
  }
  setAuthState(true);
  navigateTo('home');
  renderWidgetMessages();
  updateRateLimitDisplay();
}
/* ============================================================
   SCROLL HELPERS
   ============================================================ */
function scrollWidgetToBottom() {
  setTimeout(function() {
    var el = document.getElementById('widget-messages');
    if (el) el.scrollTop = el.scrollHeight;
  }, 50);
}
function scrollFullpageToBottom() {
  setTimeout(function() {
    var el = document.getElementById('fullpage-messages');
    if (el) el.scrollTop = el.scrollHeight;
  }, 50);
}
/* ============================================================
   UTILITIES
   ============================================================ */
function escHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
// Polyfill for findLastIndex (not in all browsers)
if (!Array.prototype.findLastIndex) {
  Array.prototype.findLastIndex = function(fn) {
    for (var i = this.length - 1; i >= 0; i--) {
      if (fn(this[i], i, this)) return i;
    }
    return -1;
  };
}
// Close modal on backdrop click
document.getElementById('clear-dialog').addEventListener('click', function(e) {
  if (e.target === this) closeClearDialog();
});
// Keyboard: Escape closes modal
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeClearDialog();
    if (state.widgetOpen) toggleWidget();
  }
});
// Show welcome message on init
function showWelcomeMessage() {
  renderWidgetMessages();
}
</script>
