<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QABOT-001 — Q&A Interop Bot Prototype</title>
<style>
/* ============================================================
   PROTOTYPE BANNER
   ============================================================ */
#proto-banner {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 9999;
  background: #fbbf24;
  color: #1c1917;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  padding: 5px 12px;
  font-family: system-ui, -apple-system, sans-serif;
  letter-spacing: 0.01em;
}
/* ============================================================
   STARLIGHT THEME TOKENS
   ============================================================ */
:root {
  --sl-sidebar-bg: #1e1e2e;
  --sl-sidebar-text: #cdd6f4;
  --sl-sidebar-muted: #6c7086;
  --sl-sidebar-active: #cba6f7;
  --sl-sidebar-active-bg: rgba(203,166,247,0.12);
  --sl-sidebar-hover: rgba(203,166,247,0.07);
  --sl-sidebar-border: rgba(255,255,255,0.06);
  --sl-content-bg: #ffffff;
  --sl-content-text: #1e1b2e;
  --sl-content-muted: #6b7280;
  --sl-content-border: #e5e7eb;
  --sl-accent: #7c3aed;
  --sl-accent-light: #a78bfa;
  --sl-accent-bg: rgba(124,58,237,0.08);
  --sl-accent-hover: #6d28d9;
  --sl-header-bg: #1e1e2e;
  --sl-header-text: #cdd6f4;
  --sl-header-border: rgba(255,255,255,0.08);
  --sl-code-bg: #1e1e2e;
  --sl-code-text: #cdd6f4;
  --sl-danger: #dc2626;
  --sl-warning: #d97706;
  --sl-success: #16a34a;
  --sl-success-bg: #f0fdf4;
  --sl-error-bg: #fef2f2;
  --sl-warning-bg: #fffbeb;
  --radius: 8px;
  --radius-sm: 4px;
  --shadow: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.08);
  --shadow-lg: 0 10px 25px rgba(0,0,0,0.15), 0 4px 10px rgba(0,0,0,0.1);
}
/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; }
body {
  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  background: #f1f5f9;
  color: var(--sl-content-text);
  line-height: 1.6;
  padding-top: 30px; /* banner height */
}
/* ============================================================
   LAYOUT: PORTAL SHELL
   ============================================================ */
.portal-shell {
  display: grid;
  grid-template-rows: 48px 1fr;
  grid-template-columns: 260px 1fr;
  height: calc(100vh - 30px);
  overflow: hidden;
}
.portal-shell.fullpage-mode {
  grid-template-columns: 1fr;
}
/* HEADER */
.sl-header {
  grid-column: 1 / -1;
  background: var(--sl-header-bg);
  border-bottom: 1px solid var(--sl-header-border);
  display: flex;
  align-items: center;
  padding: 0 20px;
  gap: 16px;
  color: var(--sl-header-text);
}
.sl-header .logo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 15px;
  color: #cdd6f4;
  text-decoration: none;
}
.sl-header .logo-icon {
  width: 24px; height: 24px;
  background: var(--sl-accent);
  border-radius: 5px;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px;
  color: white;
  font-weight: 800;
}
.sl-header .header-search {
  flex: 1;
  max-width: 320px;
  margin-left: auto;
}
.sl-header .header-search input {
  width: 100%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-sm);
  padding: 5px 10px;
  color: #cdd6f4;
  font-size: 13px;
  outline: none;
}
.sl-header .header-search input::placeholder { color: var(--sl-sidebar-muted); }
.sl-header .header-auth {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #9ba3af;
}
.sl-header .auth-avatar {
  width: 28px; height: 28px;
  background: var(--sl-accent);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px;
  font-weight: 700;
  color: white;
}
/* SIDEBAR */
.sl-sidebar {
  background: var(--sl-sidebar-bg);
  border-right: 1px solid var(--sl-sidebar-border);
  overflow-y: auto;
  padding: 16px 0;
}
.sl-sidebar::-webkit-scrollbar { width: 4px; }
.sl-sidebar::-webkit-scrollbar-track { background: transparent; }
.sl-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }
.sl-sidebar-section {
  margin-bottom: 8px;
}
.sl-sidebar-section-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--sl-sidebar-muted);
  padding: 8px 16px 4px;
}
.sl-sidebar-item {
  display: block;
  padding: 6px 16px;
  font-size: 13.5px;
  color: var(--sl-sidebar-text);
  text-decoration: none;
  cursor: pointer;
  border-radius: 0;
  transition: background 0.1s;
  border: none;
  background: none;
  width: 100%;
  text-align: left;
}
.sl-sidebar-item:hover { background: var(--sl-sidebar-hover); }
.sl-sidebar-item.active {
  color: var(--sl-sidebar-active);
  background: var(--sl-sidebar-active-bg);
  font-weight: 500;
}
.sl-sidebar-item.sub {
  padding-left: 28px;
  font-size: 13px;
}
/* MAIN CONTENT */
.sl-content {
  background: var(--sl-content-bg);
  overflow-y: auto;
  position: relative;
}
.sl-content::-webkit-scrollbar { width: 6px; }
.sl-content::-webkit-scrollbar-track { background: transparent; }
.sl-content::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 3px; }
.content-inner {
  max-width: 820px;
  margin: 0 auto;
  padding: 40px 48px 80px;
}
.content-inner h1 {
  font-size: 28px;
  font-weight: 800;
  color: var(--sl-content-text);
  margin-bottom: 8px;
  line-height: 1.2;
}
.content-inner .page-description {
  font-size: 16px;
  color: var(--sl-content-muted);
  margin-bottom: 32px;
  border-bottom: 1px solid var(--sl-content-border);
  padding-bottom: 24px;
}
.content-inner h2 {
  font-size: 20px;
  font-weight: 700;
  margin: 32px 0 12px;
  color: var(--sl-content-text);
}
.content-inner h3 {
  font-size: 16px;
  font-weight: 600;
  margin: 24px 0 8px;
  color: var(--sl-content-text);
}
.content-inner p {
  margin-bottom: 16px;
  color: #374151;
  font-size: 15px;
}
.content-inner code {
  background: var(--sl-code-bg);
  color: var(--sl-accent-light);
  padding: 2px 6px;
  border-radius: 3px;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  font-size: 13px;
}
.content-inner pre {
  background: var(--sl-code-bg);
  border-radius: var(--radius);
  padding: 20px;
  overflow-x: auto;
  margin: 16px 0;
}
.content-inner pre code {
  background: none;
  color: #cdd6f4;
  font-size: 13px;
  padding: 0;
}
.content-inner .aside {
  background: var(--sl-accent-bg);
  border-left: 3px solid var(--sl-accent);
  border-radius: 0 var(--radius) var(--radius) 0;
  padding: 12px 16px;
  margin: 16px 0;
  font-size: 14px;
  color: #4c1d95;
}
/* BREADCRUMB */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--sl-content-muted);
  margin-bottom: 20px;
}
.breadcrumb span { opacity: 0.5; }
/* UNAUTHENTICATED VIEW */
#view-unauth {
  display: none;
}
.unauth-content {
  max-width: 480px;
  margin: 80px auto;
  text-align: center;
  padding: 40px;
  background: white;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.unauth-content .lock-icon {
  font-size: 48px;
  margin-bottom: 16px;
}
.unauth-content h2 {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--sl-content-text);
}
.unauth-content p {
  color: var(--sl-content-muted);
  font-size: 14px;
  margin-bottom: 24px;
}
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--sl-accent);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
  text-decoration: none;
}
.btn-primary:hover { background: var(--sl-accent-hover); }
.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: white;
  color: var(--sl-content-text);
  border: 1px solid var(--sl-content-border);
  border-radius: var(--radius-sm);
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s;
}
.btn-secondary:hover { background: #f9fafb; }
.btn-danger {
  background: var(--sl-danger);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
}
.btn-danger:hover { background: #b91c1c; }
/* ============================================================
   DEMO TOOLBAR
   ============================================================ */
.demo-toolbar {
  position: fixed;
  bottom: 0; left: 0;
  z-index: 8000;
  background: #1e1e2e;
  border-top: 1px solid rgba(255,255,255,0.1);
  border-right: 1px solid rgba(255,255,255,0.1);
  border-radius: 0 8px 0 0;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  max-width: 560px;
}
.demo-toolbar .toolbar-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #6c7086;
  margin-right: 4px;
}
.demo-btn {
  background: rgba(255,255,255,0.07);
  color: #cdd6f4;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.1s;
  white-space: nowrap;
}
.demo-btn:hover { background: rgba(255,255,255,0.13); }
.demo-btn.active { background: rgba(203,166,247,0.2); color: var(--sl-sidebar-active); border-color: rgba(203,166,247,0.3); }
/* ============================================================
   CHAT WIDGET
   ============================================================ */
#chat-widget {
  position: fixed;
  bottom: 48px; right: 24px;
  z-index: 7000;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12px;
}
/* Widget FAB button */
.widget-fab {
  width: 52px; height: 52px;
  background: var(--sl-accent);
  border-radius: 50%;
  border: none;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-lg);
  transition: transform 0.15s, background 0.15s;
  position: relative;
  color: white;
  font-size: 22px;
}
.widget-fab:hover { transform: scale(1.06); background: var(--sl-accent-hover); }
.widget-fab .unread-badge {
  position: absolute;
  top: -2px; right: -2px;
  width: 18px; height: 18px;
  background: #ef4444;
  border-radius: 50%;
  border: 2px solid white;
  font-size: 10px;
  font-weight: 700;
  color: white;
  display: flex; align-items: center; justify-content: center;
}
/* Widget panel */
.widget-panel {
  width: 380px;
  height: 520px;
  background: white;
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--sl-content-border);
  animation: widget-appear 0.2s ease-out;
}
@keyframes widget-appear {
  from { opacity: 0; transform: translateY(12px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
/* Widget header */
.widget-header {
  background: var(--sl-accent);
  color: white;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.widget-header .bot-avatar {
  width: 32px; height: 32px;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
}
.widget-header .bot-info { flex: 1; }
.widget-header .bot-name { font-size: 14px; font-weight: 700; }
.widget-header .bot-status { font-size: 11px; opacity: 0.8; display: flex; align-items: center; gap: 4px; }
.widget-header .status-dot {
  width: 6px; height: 6px;
  background: #4ade80;
  border-radius: 50%;
  display: inline-block;
}
.widget-header-actions {
  display: flex; gap: 4px;
}
.widget-icon-btn {
  background: rgba(255,255,255,0.15);
  border: none;
  border-radius: 6px;
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  color: white;
  font-size: 13px;
  transition: background 0.1s;
}
.widget-icon-btn:hover { background: rgba(255,255,255,0.25); }
.widget-icon-btn title { display: none; }
/* Messages area */
.widget-messages {
  flex: 1;
  overflow-y: auto;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #f8fafc;
}
.widget-messages::-webkit-scrollbar { width: 4px; }
.widget-messages::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 2px; }
/* Message bubbles */
.msg {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  max-width: 100%;
}
.msg.user { flex-direction: row-reverse; }
.msg-avatar {
  width: 28px; height: 28px;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px;
  font-weight: 700;
}
.msg.bot .msg-avatar { background: var(--sl-accent); color: white; }
.msg.user .msg-avatar { background: #e0e7ff; color: var(--sl-accent); }
.msg-bubble {
  max-width: 84%;
  padding: 10px 12px;
  border-radius: 12px;
  font-size: 13.5px;
  line-height: 1.5;
}
.msg.bot .msg-bubble {
  background: white;
  border: 1px solid var(--sl-content-border);
  border-top-left-radius: 2px;
  color: var(--sl-content-text);
}
.msg.user .msg-bubble {
  background: var(--sl-accent);
  color: white;
  border-top-right-radius: 2px;
}
/* Citation card */
.citation-card {
  margin-top: 8px;
  background: var(--sl-accent-bg);
  border: 1px solid rgba(124,58,237,0.2);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
  font-size: 12px;
}
.citation-card .citation-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--sl-accent);
  margin-bottom: 4px;
}
.citation-card .citation-url {
  color: var(--sl-accent);
  font-family: monospace;
  font-size: 11px;
  word-break: break-all;
  display: block;
  margin-bottom: 4px;
}
.citation-card .citation-quote {
  color: #4c1d95;
  font-style: italic;
  font-size: 12px;
  border-left: 2px solid var(--sl-accent-light);
  padding-left: 8px;
}
/* Loading / status */
.loading-state {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.loading-bubble {
  background: white;
  border: 1px solid var(--sl-content-border);
  border-radius: 12px;
  border-top-left-radius: 2px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  color: var(--sl-content-muted);
  min-width: 160px;
}
.loading-dots {
  display: flex; gap: 4px; align-items: center;
}
.loading-dot {
  width: 7px; height: 7px;
  background: var(--sl-accent-light);
  border-radius: 50%;
  animation: dot-pulse 1.2s infinite ease-in-out;
}
.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-pulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.85); }
  40% { opacity: 1; transform: scale(1); }
}
.status-text {
  font-size: 12px;
  color: var(--sl-content-muted);
  display: flex;
  align-items: center;
  gap: 5px;
}
.status-spinner {
  width: 12px; height: 12px;
  border: 2px solid #e0e7ff;
  border-top-color: var(--sl-accent);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }
/* Welcome message */
.welcome-msg {
  text-align: center;
  padding: 20px 16px;
  color: var(--sl-content-muted);
}
.welcome-msg .welcome-icon { font-size: 32px; margin-bottom: 8px; }
.welcome-msg h4 { font-size: 14px; font-weight: 700; color: var(--sl-content-text); margin-bottom: 4px; }
.welcome-msg p { font-size: 12.5px; }
.welcome-suggestions {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 12px;
}
.suggestion-chip {
  background: white;
  border: 1px solid rgba(124,58,237,0.25);
  border-radius: 20px;
  padding: 6px 12px;
  font-size: 12px;
  color: var(--sl-accent);
  cursor: pointer;
  text-align: left;
  transition: background 0.1s, border-color 0.1s;
}
.suggestion-chip:hover { background: var(--sl-accent-bg); border-color: var(--sl-accent); }
/* Error / timeout */
.error-bubble {
  background: var(--sl-error-bg);
  border: 1px solid #fca5a5;
  border-radius: 12px;
  border-top-left-radius: 2px;
  padding: 10px 12px;
  font-size: 13px;
  color: var(--sl-danger);
}
.error-bubble .error-actions {
  margin-top: 8px;
  display: flex;
  gap: 8px;
}
.error-link {
  font-size: 12px;
  color: var(--sl-accent);
  cursor: pointer;
  text-decoration: underline;
  background: none;
  border: none;
  padding: 0;
}
/* Deflection bubble */
.deflection-bubble {
  background: var(--sl-warning-bg);
  border: 1px solid #fcd34d;
  border-radius: 12px;
  border-top-left-radius: 2px;
  padding: 10px 12px;
  font-size: 13px;
  color: #92400e;
}
/* Escalation form */
.escalation-form {
  margin-top: 10px;
  background: white;
  border: 1px solid var(--sl-content-border);
  border-radius: var(--radius);
  padding: 12px;
}
.escalation-form .esc-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--sl-content-text);
  margin-bottom: 8px;
}
.escalation-form .esc-desc {
  font-size: 12px;
  color: var(--sl-content-muted);
  margin-bottom: 10px;
}
.form-field { margin-bottom: 8px; }
.form-label {
  display: block;
  font-size: 12px;
  font-weight: 500;
  color: var(--sl-content-text);
  margin-bottom: 4px;
}
.form-input {
  width: 100%;
  border: 1px solid var(--sl-content-border);
  border-radius: var(--radius-sm);
  padding: 7px 10px;
  font-size: 13px;
  color: var(--sl-content-text);
  outline: none;
  transition: border-color 0.15s;
  background: white;
}
.form-input:focus { border-color: var(--sl-accent); box-shadow: 0 0 0 2px rgba(124,58,237,0.12); }
.form-input.error { border-color: var(--sl-danger); }
.form-error {
  font-size: 11px;
  color: var(--sl-danger);
  margin-top: 3px;
  display: none;
}
.form-error.visible { display: block; }
.esc-submit {
  width: 100%;
  background: var(--sl-accent);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
  margin-top: 4px;
}
.esc-submit:hover { background: var(--sl-accent-hover); }
.esc-submit:disabled { background: #a78bfa; cursor: not-allowed; }
/* Escalation success */
.escalation-success {
  background: var(--sl-success-bg);
  border: 1px solid #86efac;
  border-radius: var(--radius);
  padding: 12px;
  font-size: 13px;
  color: #14532d;
  display: flex;
  gap: 8px;
  align-items: flex-start;
}
.escalation-success .success-icon { font-size: 16px; flex-shrink: 0; }
/* Widget input area */
.widget-input-area {
  padding: 10px 12px;
  border-top: 1px solid var(--sl-content-border);
  background: white;
  flex-shrink: 0;
}
.widget-input-row {
  display: flex;
  gap: 8px;
  align-items: flex-end;
}
.widget-input {
  flex: 1;
  border: 1px solid var(--sl-content-border);
  border-radius: 20px;
