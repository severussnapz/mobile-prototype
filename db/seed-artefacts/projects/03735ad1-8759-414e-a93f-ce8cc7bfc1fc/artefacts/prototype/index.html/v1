/* ============================================================
   SEND MESSAGE
   ============================================================ */
function sendWidgetMessage() {
  var input = document.getElementById('widget-input');
  var text = input.value.trim();
  if (!text || state.isLoading) return;
  if (state.rateLimit <= 0) {
    showRateLimitWarning();
    return;
  }
  input.value = '';
  state.rateLimit--;
  state.messageCount++;
  // Add user message
  state.messages.push({ type: 'user', text: text });
  renderWidgetMessages();
  scrollWidgetToBottom();
  // Show loading
  showWidgetLoading();
  // Determine response (simple keyword matching for demo)
  var scenario = detectScenario(text);
  var delay = scenario === 'timeout' ? 1500 : 2000;
  setTimeout(function() {
    hideWidgetLoading();
    var response = SCENARIOS[scenario] ? SCENARIOS[scenario].botResponse : SCENARIOS['in-scope'].botResponse;
    state.messages.push(response);
    renderWidgetMessages();
    scrollWidgetToBottom();
    updateRateLimitDisplay();
  }, delay);
}
function sendFullpageMessage() {
  var input = document.getElementById('fullpage-input');
  var text = input.value.trim();
  if (!text || state.isLoading) return;
  if (state.rateLimit <= 0) return;
  input.value = '';
  state.rateLimit--;
  state.messageCount++;
  state.messages.push({ type: 'user', text: text });
  renderFullpageMessages();
  scrollFullpageToBottom();
  // Show loading in fullpage
  showFullpageLoading();
  var scenario = detectScenario(text);
  var delay = scenario === 'timeout' ? 1500 : 2000;
  setTimeout(function() {
    hideFullpageLoading();
    var response = SCENARIOS[scenario] ? SCENARIOS[scenario].botResponse : SCENARIOS['in-scope'].botResponse;
    state.messages.push(response);
    renderFullpageMessages();
    scrollFullpageToBottom();
  }, delay);
}
function detectScenario(text) {
  var lower = text.toLowerCase();
  if (lower.includes('weather') || lower.includes('stock') || lower.includes('recipe') || lower.includes('sport')) return 'deflection';
  if (lower.includes('escalat') || lower.includes('token refresh') || lower.includes('smart on fhir') || lower.includes('mid-consult')) return 'escalation';
  if (lower.includes('data model') || lower.includes('full') && lower.includes('clinical')) return 'timeout';
  return 'in-scope';
}
function handleWidgetKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendWidgetMessage();
  }
}
function handleFullpageKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendFullpageMessage();
  }
}
